# OPD Claims Tool - Backend Environment Variables

# MongoDB Connection
# Local: mongodb://localhost:27017/opd_claims
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/opd_claims
MONGODB_URL=mongodb://localhost:27017/opd_claims

# Ollama Configuration (local Llama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# Server
PORT=8000
NODE_ENV=development
